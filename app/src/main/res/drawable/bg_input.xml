<?xml version="1.0" encoding="utf-8"?>
<!-- 设备地址/端口输入框：圆角描边 + 浅底，聚焦时描边变主色并加粗，替代系统默认的"只有一条下划线" -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="2dp" android:color="@color/primary" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#EEF4FC" />
            <stroke android:width="1.5dp" android:color="@color/primary_light" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F7FAFE" />
            <stroke android:width="1.5dp" android:color="#C9D6E6" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
