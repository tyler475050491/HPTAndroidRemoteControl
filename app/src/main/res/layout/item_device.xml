<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:orientation="vertical"
    android:paddingLeft="6dp"
    android:paddingTop="6dp"
    android:paddingRight="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cbSelect"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:buttonTint="@color/primary"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="未知设备"
                android:textColor="@color/text_main"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="已连接"
                android:textColor="@color/ok_green"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRowMirror"
            style="@style/TableButton"
            android:layout_width="48dp"
            android:backgroundTint="@color/primary"
            android:text="@string/btn_mirror"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnRowDisconnect"
            style="@style/TableButton"
            android:layout_width="48dp"
            android:layout_marginLeft="2dp"
            android:backgroundTint="@color/text_sub"
            android:text="@string/btn_disconnect"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnRowReboot"
            style="@style/TableButton"
            android:layout_width="48dp"
            android:layout_marginLeft="2dp"
            android:backgroundTint="@color/reboot"
            android:text="@string/btn_reboot"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="-"
        android:textColor="@color/text_main"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvInfo2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="36dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="-"
        android:textColor="@color/text_sub"
        android:textSize="10sp" />
</LinearLayout>
