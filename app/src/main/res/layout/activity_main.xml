<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="@string/title_in_app"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 版本徽标：标题下方单独一行右对齐，避免压住居中的标题 -->
            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_ver_badge"
                android:paddingLeft="7dp"
                android:paddingTop="1dp"
                android:paddingRight="7dp"
                android:paddingBottom="1dp"
                android:textColor="#DCE9F6"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 2. 投屏预览画布 -->
        <FrameLayout
            android:id="@+id/previewBox"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bg_preview">

            <com.hpt.adbtool.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tvPreviewHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="@string/preview_hint"
                android:textColor="#7C8A99"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPreviewState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="#66000000"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:textColor="#CFE3F5"
                android:textSize="10sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnFullscreen"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="#66000000"
                android:contentDescription="@string/btn_fullscreen"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_fullscreen" />
        </FrameLayout>

        <!-- 3. 连接地址 + 端口 + 连接/刷新/搜索 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <EditText
                android:id="@+id/etHost"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_host"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:singleLine="true"
                android:textColor="@color/text_main"
                android:textColorHint="#A8B2BF"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etPort"
                android:layout_width="64dp"
                android:layout_height="46dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:hint="@string/hint_port"
                android:inputType="number"
                android:maxLength="5"
                android:maxLines="1"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:singleLine="true"
                android:text="5555"
                android:textColor="@color/text_main"
                android:textColorHint="#A8B2BF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginLeft="4dp"
                android:backgroundTint="@color/primary"
                android:minWidth="78dp"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:text="@string/btn_connect"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginLeft="3dp"
                android:backgroundTint="@color/accent"
                android:minWidth="50dp"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="@string/btn_refresh"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginLeft="3dp"
                android:backgroundTint="@color/search_purple"
                android:minWidth="50dp"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="@string/btn_search"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 4. 设备信息表格 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:minHeight="110dp">

                <ScrollView
                    android:id="@+id/svDevices"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="false">

                    <LinearLayout
                        android:id="@+id/llDevices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <TextView
                    android:id="@+id/tvNoDevice"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="@string/no_device"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- 5. 退出桌面 / 安装 / 卸载 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnExitDesktop"
                style="@style/MainButton"
                android:layout_weight="0.85"
                android:backgroundTint="@color/text_sub"
                android:text="@string/btn_exit_desktop"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnInstall"
                style="@style/MainButton"
                android:layout_marginLeft="8dp"
                android:layout_weight="1.1"
                android:backgroundTint="@color/install"
                android:text="@string/btn_install" />

            <Button
                android:id="@+id/btnUninstall"
                style="@style/MainButton"
                android:layout_marginLeft="8dp"
                android:layout_weight="1.1"
                android:backgroundTint="@color/uninstall"
                android:text="@string/btn_uninstall" />
        </LinearLayout>

        <!-- 6. 日志 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_log"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/log_title"
                    android:textColor="#8FA6BF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnClearLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingLeft="10dp"
                    android:paddingTop="4dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/btn_clear_log"
                    android:textColor="#4FB8E8"
                    android:textSize="12sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/svLog"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/log_text"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- 全屏投屏层 -->
    <FrameLayout
        android:id="@+id/flFull"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#99000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <TextView
                android:id="@+id/tvFullState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="6dp"
                android:textColor="#CFE3F5"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/btnRotate"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/btn_rotate"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rotate" />

            <ImageView
                android:id="@+id/btnExitFull"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/btn_exit_fullscreen"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
